@startuml
skinparam rectangle {
  RoundCorner 15
}
skinparam ArrowColor #333333
skinparam defaultTextAlignment center

rectangle "Componente cliente HTTP\n(navegador, app, interfaz de seguridad)" as cliente #DDDDDD

rectangle "1. seguridad · config · util" as capa1 #F5CFCF {
  rectangle "JwtAuthenticationFilter\nintercepta cada solicitud" as jwtFilter #E68A8A
  rectangle "JwtUtil\nfirma y valida HS256" as jwtUtil #E68A8A
  rectangle "securityConfiguration\nreglas de acceso por rol" as secConfig #E68A8A
  rectangle "Configuración\nExcepción errores globales" as configExc #E68A8A
}

rectangle "2. presentación · paquetes controller . Cartografo" as capa2 #A9D1F5 {
  rectangle "controlador 11\n@RestController + DTOs" as controllers #7FB2E8
  rectangle "mapper 10 mappers\nMapStruct" as mappers #7FB2E8
  rectangle "SwaggerConfig\nSpringDoc -> Swagger UI" as swagger #B8E8B8
}

rectangle "3. Servicio de Negocios Paquets. Imp" as capa3 #F5CFCF {
  rectangle "AuthenticateServiceImpl\nimplementa UserDetailsService" as authImpl #E68A8A
  rectangle "servicio + servicio imp\n12 interfaces y 12 implementaciones" as servicios #7FB2E8
}

rectangle "4. persistencia y dominio paquetes repository . Modelo" as capa4 #DDDDDD {
  rectangle "Repositorio\n10 interfaces Spring Data JPA" as repos #C9C9F5
  rectangle "Modelo\n10 entidades JPA" as modelo #C9C9F5
}

database "PostgreSQL\n13 tablas" as pg

cliente -down-> capa1 : HTTP / JSON\nAutorización: Portador
jwtFilter -right-> secConfig
capa1 -down-> capa2 : Solicitud autorizada
secConfig .down.> authImpl : loadUserByUsername()
controllers -down-> servicios : delega
servicios -down-> capa4 : Consulta
repos -down-> pg : JDBC / Hibernate

@enduml
