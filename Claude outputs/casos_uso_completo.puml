@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #E8E8FF
  BorderColor #6060BB
  FontColor #222222
}

actor Profesor
actor Estudiante
actor Acudiente

usecase "Autenticar usuario" as UC01
usecase "Gestionar profesores" as UC02
usecase "Gestionar estudiantes" as UC03
usecase "Gestionar acudientes" as UC04
usecase "Gestionar grados" as UC05
usecase "Gestionar materias" as UC06
usecase "Gestionar matrículas" as UC07
usecase "Registrar notas" as UC08
usecase "Consultar información académica" as UC09

' ---- Casos de uso de la extensión: asistencia, alertas y seguimiento ----
usecase "Registrar asistencia" as UC10
usecase "Evaluar y gestionar alertas" as UC11
usecase "Registrar seguimiento" as UC12

Profesor --> UC01
Profesor --> UC02
Profesor --> UC03
Profesor --> UC04
Profesor --> UC05
Profesor --> UC06
Profesor --> UC07
Profesor --> UC08
Profesor --> UC10
Profesor --> UC11
Profesor --> UC12

Estudiante --> UC01
Estudiante --> UC09

Acudiente --> UC01
Acudiente --> UC09

@enduml
